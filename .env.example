# ---------------------------------------------------------------------------
# ResumeRadar environment template. Copy to .env and fill in real values.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
APP_NAME=ResumeRadar
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Postgres for real usage; sqlite for quick local dev.
DATABASE_URL=sqlite:///./data/resume_radar.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider (user-supplied key is used per-request, this is the fallback) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Reddit (official API via OAuth) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=resume-radar/0.1

# --- Public data sources ---
GITHUB_TOKEN=

# --- Limits / caching ---
CACHE_TTL_SECONDS=86400
MAX_UPLOAD_MB=10
